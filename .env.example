# Supabase — supabase.com 프로젝트 Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# 구글 Web 클라이언트 ID (웹/네이티브 공용)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# 카카오 키는 Supabase 대시보드(Authentication → Providers → Kakao)에 입력

# 웹 Push VAPID 공개키 (없으면 웹은 setTimeout 폴백으로 동작)
# 생성: npx web-push generate-vapid-keys  → 공개키를 여기, 비밀키는 Supabase 시크릿으로
VITE_VAPID_PUBLIC_KEY=

# AI 코칭 서버·로컬 비교 평가용 비밀키. VITE_ 접두사를 붙이지 않는다.
# 실제 값은 .env.local 또는 Supabase 서버 시크릿에만 저장한다.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 서버 기본 경로는 Claude. OpenAI 복귀는 서버 설정을 명시적으로 변경할 때만.
ONJU_AGENT_PROVIDER=anthropic
ONJU_CLAUDE_MODEL=claude-sonnet-4-6

# 비교 평가의 기존 모델. 설정이 없으면 현재 배포용 코드의 기본 모델 사용.
ONJU_BASELINE_MODEL=gpt-5.6-sol
